# ---------- OKX ----------
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# demo trading: set to 1 to send the x-simulated-trading: 1 header
OKX_SIMULATED=0
# OKX region / host; www.okx.com is the global host, app.okx.com is used in some regions
OKX_BASE_URL=https://www.okx.com
OKX_WS_PUBLIC=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_PRIVATE=wss://ws.okx.com:8443/ws/v5/private

# ---------- Lighter ----------
# API key private key (hex) generated with lighter.GenerateAPIKey / the SDK helper
LIGHTER_API_PRIVATE_KEY=
# API key index, 4..254 (0..3 are reserved for Lighter apps)
LIGHTER_API_KEY_INDEX=
# Second API key, used only for IOC escalation (keeps the quoting key free)
LIGHTER_API_PRIVATE_KEY_TAKER=
LIGHTER_API_KEY_INDEX_TAKER=
# Lighter account index (integer, from accountsByL1Address)
LIGHTER_ACCOUNT_INDEX=
# Mainnet base url; Robinhood-chain variant: https://api.rh.lighter.xyz (chain id 466324)
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/stream

# ---------- engine ----------
ARBTWIN_CONFIG=config/venues.yaml
ARBTWIN_RISK=config/risk.yaml
ARBTWIN_SYMBOLS=config/symbols.yaml
ARBTWIN_STATE_DIR=state
# keep 1 for a completely offline-safe run; orders are logged, never sent
ARBTWIN_DRY_RUN=1
# optional alert sink (POST json); leave empty to only log
ARBTWIN_ALERT_WEBHOOK=

# HTTP proxy for REST calls (also used for websockets when set).
# Leave empty for direct access; e.g. http://192.168.1.5:7890
ARBTWIN_PROXY=

# decision loop period, telemetry dir and history cache dir
ARBTWIN_POLL_MS=250
ARBTWIN_CACHE=state/cache